# Rendered at container start by the nginx image's envsubst step: only
# variables present in the environment (API_UPSTREAM, NGINX_LOCAL_RESOLVERS)
# are substituted; nginx's own $variables are left untouched.

# Resolve the API host per request rather than once at startup, so the
# dashboard boots even when the api container is not up yet (or at all) and
# follows it when it is recreated with a new address.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/snippets/security-headers.conf;

    set $api_upstream ${API_UPSTREAM};

    # nginx is the outermost hop, so X-Forwarded-For is set to the peer address
    # rather than appended to a client-supplied (spoofable) value.
    #
    # API and backend health check: forwarded unchanged (path, query, body and
    # headers, including Set-Cookie on the way back) to the api container.
    # A variable proxy_pass with no URI part passes the original request URI.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # Vite emits content-hashed file names under /assets: cache them forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Client-side routes (/companies, /operations, …) fall back to the SPA
    # entry point, which must never be cached so a deploy is picked up at once.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
